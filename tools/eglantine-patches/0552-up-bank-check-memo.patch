                : 0;
 }
 
+/// EDEN_UP_BANK_CHECK_MEMO: microseconds, 1 to 2000; unset, 0 or anything else is 0 (off).
+[[nodiscard]] inline s64 ParseBankCheckMemo(const char* text) noexcept {
+    if (text == nullptr || text[0] == '\0') {
+        return 0;
+    }
+    s64 value = 0;
+    for (const char* at = text; *at != '\0'; ++at) {
+        if (*at < '0' || *at > '9' || value > 2000) {
+            return 0;
+        }
+        value = value * 10 + (*at - '0');
+    }
+    return value <= 2000 ? value : 0;
+}
+
 struct Def {
     const char* name;
     s64 (*parse)(const char* text);
@@ -185,6 +203,7 @@ inline constexpr std::array<Def, NumSwitches> kDefs{{
     {"EDEN_UP_COND_BACK", ParseOneOrTwo, false, -1},
     {"EDEN_UP_SWIZZLE_UNITS", ParseExactOne, false, -1},
     {"EDEN_UP_AHEAD_ALWAYS", ParseExactOne, false, -1},
+    {"EDEN_UP_BANK_CHECK_MEMO", ParseBankCheckMemo, false, -1},
 }};
 
